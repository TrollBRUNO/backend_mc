# node_modules ставятся внутри образа (RUN npm install). Без этого файла
# COPY . . затирал их локальными — а у sharp бинарник платформозависимый,
# и собранный на рабочей машине мог не совпасть с окружением контейнера
node_modules
dist

.git
.gitignore
*.md

# Тесты и служебное в образе не нужны
**/*.spec.ts
migrations

# Локальное окружение
.env
.env.*
